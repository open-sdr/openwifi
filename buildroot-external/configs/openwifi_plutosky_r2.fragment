BR2_LINUX_KERNEL_INTREE_DTS_NAME="xilinx/plutosky_r2"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_FULL=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# mk-plutosky-r2-qspi-firmware.sh packs the QSPI image as a FIT, which mkimage
# only understands when it is built with FIT support.
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
